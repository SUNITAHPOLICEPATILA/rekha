<!-- Updated Amity Scholarship Login Page with Real Google & GitHub OAuth Placeholder -->
<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8" />
<meta name="vie  wport" content="width=device-width, initial-scale=1.0" />
<title>Amity Scholarship Login</title>
<script src="https://cdn.tailwindcss.com"></script>
<body class="bg-gray-100 text-gray-800">
<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-xl shadow-md">
 <div class="text-center mb-6">
 <img src="amity logo.jpg" class="w-32 mx-auto mb-2" alt="Amity Logo">
 <h1 class="text-xl font-semibold">Amity Scholarship Login</h1>
 </div>
<!-- Eligibility Criteria -->
 <div class="bg-blue-50 border border-blue-200 rounded p-4 text-sm mb-4">
<h2 class="font-semibold mb-2 text-blue-800">Eligibility Criteria:</h2>
<ul class="list-disc list-inside text-gray-700 space-y-1">
<li>Use your university email (example@s.amity.edu)</li>
 <li>Minimum 7.0 CGPA in the last semester</li>
 <li>No active backlogs or arrears</li>
<li>Must be currently studying at Amity University</li>
 <li>Must be a resident of Karnataka</li>
 <li>Confirm you are not a robot</li>
    </ul>
</div>
<form onsubmit="validateForm(event)" class="space-y-4">
     <input type="text" id="name" placeholder="Full Name" class="w-full border px-4 py-2 rounded" required>
<input type="text" id="sen" placeholder="SEN Number (e.g., A866)" class="w-full border px-4 py-2 rounded" required>
<input type="text" id="phone" placeholder="Phone Number (10 digits)" class="w-full border px-4 py-2 rounded" pattern="\d{10}" required>
  <input type="email" id="email" placeholder="example@s.amity.edu" class="w-full border px-4 py-2 rounded" pattern=".*@s\.amity\.edu" required>

 <!-- Password -->
<div class="relative">
 <input type="password" id="password" placeholder="Password" class="w-full border px-4 py-2 pr-10 rounded" required>
 <button type="button" onclick="togglePassword()" class="absolute top-2 right-2 text-xl" id="eye-icon">👁️</button>
</div>
 <!-- Confirm Password -->
 <input type="password" id="confirmPassword" placeholder="Confirm Password" class="w-full border px-4 py-2 rounded" required>
 <!-- Eligibility -->
  <input type="number" step="0.01" id="result" placeholder="Previous Semester CGPA" class="w-full border px-4 py-2 rounded" required>
 <select id="arrears" class="w-full border px-4 py-2 rounded" required>
 <option value="">Do you have arrears?</option>
     <option value="no">No</option>
 <option value="yes">Yes</option>
      </select>
 <label><input type="checkbox" id="studying" class="mr-2">Currently studying at Amity</label>
 <label><input type="checkbox" id="karnataka" class="mr-2">Resident of Karnataka</label>
  <label><input type="checkbox" id="eligibility-check" class="mr-2">I confirm all eligibility conditions</label>

 <!-- Human Verification --> 
<label class="block text-sm font-medium text-gray-700">
 <div class="flex items-center gap-3 border rounded-md px-4 py-3 bg-gray-50 mt-4">
 <input type="checkbox" id="not-robot" class="w-5 h-5" required>
<img src="https://cdn-icons-png.flaticon.com/512/4712/4712139.png" alt="Robot" class="h-6 w-6">
 <span class="text-sm">I am not a robot</span>
  </div>

 
